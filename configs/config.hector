
MODEL = model300

FC     = ftn

FFLAGS = -Mr8
OPTS = -fast -Mipa=fast,inline -O3 -Minfo -Mneginfo

MYHOME = $(HOME)
MYLHOME = $(HOME)/jorek

JOREK_DIR = $(MYHOME)/svn/trunk

MAIN_MODEL_DIR = $(JOREK_DIR)/models
MODEL_DIR      = $(MAIN_MODEL_DIR)/$(MODEL)
DATATYPES_DIR  = $(JOREK_DIR)/datatypes
MATRIX_DIR     = $(JOREK_DIR)/matrix
ELEMENTS_DIR   = $(JOREK_DIR)/elements
SOLVERS_DIR    = $(JOREK_DIR)/solvers
VACUUM_DIR     = $(JOREK_DIR)/vacuum
GRID_DIR       = $(JOREK_DIR)/grids

LIBSCOTCH   = -L$(MYLHOME)/scotch_5.1_debug/scotch_5.1/lib -lptscotch -lscotcherr 

LIBMUMPS  = -L$(MYLHOME)/MUMPS_4.8.1/lib -ldmumps -lmumps_common
LIBZMUMPS = -L$(MYLHOME)/MUMPS_4.8.1/lib/libzmumps.a
INCMUMPS  = $(MYLHOME)/MUMPS_4.8.1/include/
ORDLIB    = $(MYLHOME)/MUMPS_4.8.1/lib/libpord.a $(MYLHOME)/metis-4.0/libmetis.a $(LSCOTCH)

PPPLIB    = $(MYLHOME)/ppplib.o

LIBPASTIX = $(MYLHOME)/pastix_release_1789/install/libpastix.a
#LIBFFTW   = /opt/fftw/lib/libfftw3.a
#LIBLAPACK = -L/opt/intel/mkl/10.0.1.014/lib/em64t -lmkl_lapack -lmkl_intel_lp64 -lmkl_sequential -lmkl_core -lguide
#SCALAP    = -L/home/GH200582/scalapack-1.8.0 -lscalapack
#BLACS     = /home/GH200582/BLACS/LIB/blacs_MPI-LINUX-0.a /home/GH200582/BLACS/LIB/blacsF77init_MPI-LINUX-0.a /home/GH200582/BLACS/LIB/blacsCinit_MPI-LINUX-0.a

LIBS =  $(LIBPASTIX) $(LIBSCOTCH) $(LIBMUMPS) $(ORDLIB) $(PPPLIB)

INCLUDES  = -I$(DATATYPES_DIR) -I$(GRID_DIR) -I$(MODEL_DIR) -I$(MATRIX_DIR) -I$(ELEMENTS_DIR) -I$(VACUUM_DIR) -I$(SOLVERS_DIR) -I$(INCMUMPS) -I.

VPATH = $(MAIN_MODEL_DIR) $(MODEL_DIR) $(DATATYPES_DIR) $(SOLVERS_DIR)

.SUFFIXES: .o .f90 .f 

%.o: %.f90
	$(FC) -c $^ -o $@ $(FFLAGS) $(INCLUDES)

%.o: %.f
	$(FC) -c $^ -o $@ $(FFLAGS) $(INCLUDES)

CFLAGS := $(CFLAGS) -DUSE_MUMPS

