
MODEL = model199

FC     = mpif90 

FFLAGS = 
#FFLAGS = -r8 -i4 -O2 -xT -align
#FFLAGS = -r8 -i4 -O0 -check bounds -traceback -align -fpe0 -fp-model strict

MYHOME = $(HOME)

JOREK_DIR = $(MYHOME)/jorek/trunk

MAIN_MODEL_DIR = $(JOREK_DIR)/models
MODEL_DIR      = $(MAIN_MODEL_DIR)/$(MODEL)
DATATYPES_DIR  = $(JOREK_DIR)/datatypes
MATRIX_DIR     = $(JOREK_DIR)/matrix
ELEMENTS_DIR   = $(JOREK_DIR)/elements
SOLVERS_DIR    = $(JOREK_DIR)/solvers
VACUUM_DIR     = $(JOREK_DIR)/vacuum
GRID_DIR       = $(JOREK_DIR)/grids

LIBSCOTCH   = -L/opt/scotch/int32/lib -lscotch -lscotcherrexit

LIBMUMPS  = /opt/mumps/lib/libdmumps.a
LIBZMUMPS = /opt/mumps/lib/libzmumps.a
INCMUMPS  = /opt/mumps/include/
ORDLIB    = /opt/mumps/lib/libpord.a /opt/metis/int32/libmetis.a $(LIBSCOTCH)

PPPLIB    = $(MYHOME)/jorek/ppplib.a

LIBPASTIX = -L$(MYHOME)/pastix/install/ -lpastix
LIBFFTW   = /usr/lib/libfftw3.a
LIBLAPACK = -llapack -lblas
SCALAP    = -L/opt/scalapack -lscalapack
BLACS     = /opt/blacs/blacs_MPI-LINUX-0.a /opt/blacs/blacsF77init_MPI-LINUX-0.a /opt/blacs/blacsCinit_MPI-LINUX-0.a

LIBS = $(LIBFFTW) $(LIBPASTIX) $(LIBSCOTCH)  $(LIBMUMPS) $(ORDLIB) $(SCALAP) $(BLACS) $(BLACS) $(LIBLAPACK) $(LIBBLAS) $(PPPLIB)

INCLUDES  = -I$(DATATYPES_DIR) -I$(GRID_DIR) -I$(MODEL_DIR) -I$(MATRIX_DIR) -I$(ELEMENTS_DIR) -I$(VACUUM_DIR) -I$(SOLVERS_DIR) -I$(INCMUMPS) -I.

VPATH = $(MAIN_MODEL_DIR) $(MODEL_DIR) $(DATATYPES_DIR) $(SOLVERS_DIR)

.SUFFIXES: .o .f90 .f 

%.o: %.f90
	$(FC) -c $^ -o $@ $(FFLAGS) $(INCLUDES)

%.o: %.f
	$(FC) -c $^ -o $@ $(FFLAGS) $(INCLUDES)

CFLAGS := $(CFLAGS) -DUSE_MUMPS

