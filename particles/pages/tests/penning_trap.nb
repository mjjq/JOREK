Notebook[{

Cell[CellGroupData[{
Cell["Penning trap (analytical solution)", "Title",
 CellChangeTimes->{{3.649043780068062*^9, 3.649043786594761*^9}}],

Cell[CellGroupData[{

Cell["Initial values and constants", "Section",
 CellChangeTimes->{{3.64904379540331*^9, 3.649043799854361*^9}}],

Cell[BoxData[{
 RowBox[{
  RowBox[{"\[Omega]E", " ", "=", " ", "4.9"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Omega]B", " ", "=", " ", "25.0"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Epsilon]", " ", "=", " ", 
   RowBox[{"-", "1"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"x0", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{"10", ",", "0", ",", "0"}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"v0", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{"50", ",", "0", ",", "20"}], "}"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"tEnd", " ", "=", " ", "16"}], ";"}]}], "Input",
 CellChangeTimes->{{3.64904367836368*^9, 3.649043803966057*^9}, {
   3.649043941258122*^9, 3.649043962338338*^9}, {3.649044743368576*^9, 
   3.649044746594389*^9}, {3.6491387678139973`*^9, 3.649138838642235*^9}, {
   3.6496573309464397`*^9, 3.649657370592228*^9}, {3.649657417041362*^9, 
   3.6496574193535767`*^9}, 3.6545102383482018`*^9, {3.654510388774335*^9, 
   3.654510391198303*^9}}]
}, Open  ]],

Cell[CellGroupData[{

Cell["Equations of motion", "Section",
 CellChangeTimes->{{3.649043811147118*^9, 3.649043818705552*^9}}],

Cell["In the z-direction", "Text",
 CellChangeTimes->{{3.649044183221983*^9, 3.649044185032815*^9}}],

Cell[BoxData[{
 RowBox[{
  RowBox[{"\[Omega]Z", " ", "=", " ", 
   RowBox[{
    RowBox[{"Sqrt", "[", 
     RowBox[{
      RowBox[{"-", "2"}], "\[Epsilon]"}], "]"}], "\[Omega]E"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"z", "[", "t_", "]"}], " ", "=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"x0", "[", 
      RowBox[{"[", "3", "]"}], "]"}], " ", 
     RowBox[{"Cos", "[", "\[Omega]Z", "]"}]}], " ", "+", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"v0", "[", 
       RowBox[{"[", "3", "]"}], "]"}], "/", "\[Omega]Z"}], " ", 
     RowBox[{"Sin", "[", 
      RowBox[{"\[Omega]Z", " ", "t"}], "]"}]}]}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.649043821124837*^9, 3.6490439301469917`*^9}, {
  3.649043965185894*^9, 3.6490439905046253`*^9}, {3.6490440322917337`*^9, 
  3.649044051000475*^9}, {3.649044140820366*^9, 3.649044176867125*^9}, {
  3.64904491223386*^9, 3.64904491570691*^9}}],

Cell["In the x-y plane (w[t] = x[t] + i y[t])", "Text",
 CellChangeTimes->{{3.649044190499887*^9, 3.64904419251903*^9}, {
  3.649044493775288*^9, 3.649044502394293*^9}}],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   SubscriptBox["\[CapitalOmega]", "-"], " ", "=", " ", 
   RowBox[{
    RowBox[{"1", "/", "2"}], 
    RowBox[{"(", 
     RowBox[{"\[Omega]B", " ", "-", " ", 
      RowBox[{"Sqrt", "[", 
       RowBox[{
        SuperscriptBox["\[Omega]B", "2"], "+", 
        RowBox[{"4", " ", "\[Epsilon]", " ", 
         SuperscriptBox["\[Omega]E", "2"]}]}], "]"}]}], ")"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   SubscriptBox["\[CapitalOmega]", "+"], " ", "=", " ", 
   RowBox[{
    RowBox[{"1", "/", "2"}], 
    RowBox[{"(", 
     RowBox[{"\[Omega]B", " ", "+", " ", 
      RowBox[{"Sqrt", "[", 
       RowBox[{
        SuperscriptBox["\[Omega]B", "2"], "+", 
        RowBox[{"4", " ", "\[Epsilon]", " ", 
         SuperscriptBox["\[Omega]E", "2"]}]}], "]"}]}], ")"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   SubscriptBox["R", "-"], " ", "=", " ", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       SubscriptBox["\[CapitalOmega]", "+"], 
       RowBox[{"x0", "[", 
        RowBox[{"[", "1", "]"}], "]"}]}], " ", "+", " ", 
      RowBox[{"v0", "[", 
       RowBox[{"[", "2", "]"}], "]"}]}], ")"}], "/", 
    RowBox[{"(", 
     RowBox[{
      SubscriptBox["\[CapitalOmega]", "+"], "-", 
      SubscriptBox["\[CapitalOmega]", "-"]}], ")"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   SubscriptBox["R", "+"], " ", "=", " ", 
   RowBox[{
    RowBox[{"x0", "[", 
     RowBox[{"[", "1", "]"}], "]"}], "-", 
    SubscriptBox["R", "-"]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   SubscriptBox["T", 
    RowBox[{"-", " "}]], " ", "=", " ", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       SubscriptBox["\[CapitalOmega]", "+"], 
       RowBox[{"x0", "[", 
        RowBox[{"[", "2", "]"}], "]"}]}], " ", "+", " ", 
      RowBox[{"v0", "[", 
       RowBox[{"[", "1", "]"}], "]"}]}], ")"}], "/", 
    RowBox[{"(", 
     RowBox[{
      SubscriptBox["\[CapitalOmega]", "+"], "-", 
      SubscriptBox["\[CapitalOmega]", "-"]}], ")"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   SubscriptBox["T", "+"], "  ", "=", " ", 
   RowBox[{
    RowBox[{"x0", "[", 
     RowBox[{"[", "2", "]"}], "]"}], " ", "-", " ", 
    SubscriptBox["T", "-"]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"w", "[", "t_", "]"}], " ", "=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       SubscriptBox["R", "+"], " ", "+", " ", 
       RowBox[{"I", " ", 
        SubscriptBox["T", "+"]}]}], ")"}], 
     RowBox[{"Exp", "[", 
      RowBox[{
       RowBox[{"-", "I"}], " ", 
       SubscriptBox["\[CapitalOmega]", "+"], "t"}], "]"}]}], " ", "+", " ", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       SubscriptBox["R", "-"], "+", " ", 
       RowBox[{"I", " ", 
        SubscriptBox["T", "-"]}]}], ")"}], " ", 
     RowBox[{"Exp", "[", 
      RowBox[{
       RowBox[{"-", "I"}], " ", 
       SubscriptBox["\[CapitalOmega]", "-"], " ", "t"}], "]"}]}]}]}], 
  ";"}]}], "Input",
 CellChangeTimes->{{3.649044196437046*^9, 3.6490442004438*^9}, {
  3.6490442788155823`*^9, 3.649044473073708*^9}, {3.649044515903475*^9, 
  3.649044652468549*^9}, {3.649044891703341*^9, 3.649044907952117*^9}, {
  3.64904496031061*^9, 3.649044988349553*^9}, {3.64913881517465*^9, 
  3.649138818838619*^9}}]
}, Open  ]],

