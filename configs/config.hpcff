
MODEL = model199

FC     = mpif90

FFLAGS = -r8 -i4 -O2 -xT -align -mcmodel=medium -cpp -DUSE_R3_INFO_MPI -DUSE_R3_INFO -openmp

CC = mpicc 
CFLAGS = -DUSE_R3_INFO_MPI -DUSE_R3_INFO


FFLAGS_NO_OMP = $(FFLAGS)

MYHOME = $(HOME)

JOREK_DIR = $(MYHOME)/****/trunk

MAIN_MODEL_DIR = $(JOREK_DIR)/models
MODEL_DIR      = $(MAIN_MODEL_DIR)/$(MODEL)
DATATYPES_DIR  = $(JOREK_DIR)/datatypes
MATRIX_DIR     = $(JOREK_DIR)/matrix
ELEMENTS_DIR   = $(JOREK_DIR)/elements
SOLVERS_DIR    = $(JOREK_DIR)/solvers
TIMING_DIR     = $(JOREK_DIR)/timing
VACUUM_DIR     = $(JOREK_DIR)/vacuum
GRID_DIR       = $(JOREK_DIR)/grids

LIBSCOTCH   = -L$(MYHOME)/****/SCOTCH/lib -lptscotch -lptscotcherr

LIBMUMPS  = -L$(MYHOME)/****/MUMPS/lib/ -ldmumps -lmumps_common
INCMUMPS  = $(MYHOME)/****/MUMPS/include/
ORDLIB    = $(MYHOME)/****/MUMPS/lib/libpord.a $(MYHOME)/Soft/METIS/libmetis.a
                                                                                                   
PPPLIB    = $(MYHOME)/****/ppplib/ppplib.a

METIS     = $(MYHOME)/****/METIS/libmetis.a

DIRPASTIX = $(MYHOME)/****/install
LIBPASTIX = -L$(DIRPASTIX) -lpastix_murge -lpastix
INCPASTIX = $(DIRPASTIX)


#LIBFFTW   = -L$(MKLROOT) -lfftw3xf_intel 
LIBFFTW   = -L$(MKLROOT)

LIBLAPACK = -L$(MKLROOT) -lmkl_lapack -lmkl_intel_lp64 -lmkl_sequential -lmkl_core -lguide
SCALAP    = -L$(MKLROOT) -lmkl_scalapack_lp64 -lmkl_lapack -lmkl_intel_lp64 -lmkl_sequential -lmkl_core -lguide
BLACS     = -L$(MKLROOT) -lmkl_blacs_intelmpi_lp64


LIBS = $(LIBFFTW) $(METIS) $(LIBPASTIX) $(LIBSCOTCH)  $(LIBMUMPS) $(ORDLIB) $(SCALAP) $(BLACS) $(BLACS) $(LIBLAPACK) $(LIBBLAS) $(PPPLIB)

INCLUDES  = -I$(DATATYPES_DIR) -I$(GRID_DIR) -I$(MAIN_MODEL_DIR) -I$(MODEL_DIR) -I$(MATRIX_DIR) -I$(ELEMENTS_DIR) -I$(VACUUM_DIR) -I$(SOLVERS_DIR) -I$(TIMING_DIR) -I$(INCMUMPS) -I$(INCPASTIX) -I. 

VPATH = $(MAIN_MODEL_DIR) $(MODEL_DIR) $(DATATYPES_DIR) $(SOLVERS_DIR)

.SUFFIXES: .o .f90 .f .c

%.o: %.f90
	$(FC) -c $^ -o $@ $(FFLAGS) $(INCLUDES)

%.o: %.f
	$(FC) -c $^ -o $@ $(FFLAGS) $(INCLUDES)

%.o: %.c
	$(CC) -c $^ -o $@ $(CFLAGS) $(INCLUDES)
