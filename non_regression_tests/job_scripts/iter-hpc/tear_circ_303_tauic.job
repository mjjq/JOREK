#!/bin/bash
#SBATCH -J tear_circ_303_tauic
#SBATCH -N 2
#SBATCH -n 2
#SBATCH -t 00:20:00
#SBATCH -o tear_circ_303_tauic.%j.out
#SBATCH -e tear_circ_303_tauic.%j.err

########################################################################
# Look to non_regression_tests/testcases/tear_circ_303_tauic/settings.sh
# to determine nb of nodes, MPI processes, and nb of threads
########################################################################

ulimit -d unlimited
ulimit -s unlimited
ulimit -Sa
ulimit -Ha

# !!!!!
cd $HOME/JOREK_git_ci/non_regression_tests/job_scripts/iter-hpc
# !!!!!

CASE=tear_circ_303_tauic
JOREK_HOME=`readlink -f ${PWD}/../../..` # Assumption about source code location
echo " jorek_home = " ${JOREK_HOME}

cd ${JOREK_HOME}
source non_regression_tests/job_scripts/iter-hpc/env.sh
## Compile with:       
# non_regression_tests/run_test.sh -p $CASE
## Initial Long run: 
#non_regression_tests/run_test.sh -k -i -n $CASE 
## Restart run: 
non_regression_tests/run_test.sh -k -n $CASE 

