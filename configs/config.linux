
MODEL = model302

FC     = mpif90 -f90=ifort

#FFLAGS = -r8 -i4 -O2 -xT -align -openmp -openmp-lib compat
FFLAGS = -r8 -i4 -O0 -check bounds -traceback -align -openmp
FFLAGS_NO_OMP = -r8 -i4 -O2 -xT -align

# -i4 for openmpi

FFLAGS_NO_OMP = $(FFLAGS)

MYHOME = $(HOME)

JOREK_DIR = $(MYHOME)/jorek2_svn/trunk

MAIN_MODEL_DIR = $(JOREK_DIR)/models
MODEL_DIR      = $(MAIN_MODEL_DIR)/$(MODEL)
DATATYPES_DIR  = $(JOREK_DIR)/datatypes
MATRIX_DIR     = $(JOREK_DIR)/matrix
ELEMENTS_DIR   = $(JOREK_DIR)/elements
SOLVERS_DIR    = $(JOREK_DIR)/solvers
VACUUM_DIR     = $(JOREK_DIR)/vacuum

LIBSCOTCH   = -L/home/GH200582/scotch_5.1/lib -lscotch -lscotcherr

#LIBMUMPS  = $(MYHOME)/MUMPS_4.7.3/lib/libdmumps.a
#LIBZMUMPS = $(MYHOME)/MUMPS_4.7.3/lib/libzmumps.a
#INCMUMPS  = $(MYHOME)/MUMPS_4.7.3/include/
#ORDLIB    = $(MYHOME)/MUMPS_4.7.3/lib/libpord.a $(MYHOME)/metis-4.0/libmetis.a $(LSCOTCH)

LIBMUMPS  = -L$(MYHOME)/MUMPS_4.8.3/lib/ -ldmumps -lmumps_common
LIBZMUMPS = $(MYHOME)/MUMPS_4.8.3/lib/libzmumps.a
INCMUMPS  = $(MYHOME)/MUMPS_4.8.3/include/
ORDLIB    = $(MYHOME)/MUMPS_4.8.3/lib/libpord.a $(MYHOME)/metis-4.0/libmetis.a $(LSCOTCH)

PPPLIB    = $(MYHOME)/ppplib/ppplib.a

METIS     = $(MYHOME)/metis-4.0/libmetis.a

LIBPASTIX = -L$(MYHOME)/pastix_new/install/  -lpastix
#LIBPASTIX = -L$(MYHOME)/PastiX/install/  -lpastix
#LIBPASTIX = /home/GH200582/pastix_old/install/libpastix_64bit_mpi_smp_nobubble_int_double_real_scotch_i686_pc_linux.a

LIBFFTW   = /opt/intel/mkl/10.0.5.025/lib/em64t/libfftw3xf_intel.a #/opt/fftw/lib/libfftw3.a

#LIBLAPACK = /opt/intel/mkl/10.0.5.025/lib/em64t/libmkl_lapack.a /opt/intel/mkl/10.0.5.025/lib/em64t/libmkl_intel_ilp64.a /opt/intel/mkl/10.0.5.025/lib/em64t/libmkl_sequential.a /opt/intel/mkl/10.0.5.025/lib/em64t/libmkl_core.a /opt/intel/mkl/10.0.5.025/lib/em64t/libguide.a
#SCALAP    = /opt/intel/mkl/10.0.5.025/lib/em64t/libmkl_scalapack_lp64.a
#BLACS     = /opt/intel/mkl/10.0.5.025/lib/em64t/libmkl_blacs_intelmpi20_lp64.a

LIBLAPACK = -L/opt/intel/mkl/10.0.5.025/lib/em64t -lmkl_lapack -lmkl_intel_lp64 -lmkl_sequential -lmkl_core -liomp5
SCALAP    = -L/home/GH200582/scalapack-1.8.0 -lscalapack
BLACS     = /home/GH200582/BLACS/LIB/blacs_MPI-LINUX-0.a /home/GH200582/BLACS/LIB/blacsF77init_MPI-LINUX-0.a /home/GH200582/BLACS/LIB/blacsCinit_MPI-LINUX-0.a

LIBS = $(LIBFFTW) $(METIS) $(LIBPASTIX) $(LIBSCOTCH)  $(LIBMUMPS) $(ORDLIB) $(SCALAP) $(BLACS) $(BLACS) $(LIBLAPACK) $(LIBBLAS) $(PPPLIB)

INCLUDES  = -I$(DATATYPES_DIR) -I$(MAIN_MODEL_DIR) -I$(MODEL_DIR) -I$(MATRIX_DIR) -I$(ELEMENTS_DIR) -I$(VACUUM_DIR)  -I$(SOLVERS_DIR) -I$(INCMUMPS) -I.

VPATH = $(MAIN_MODEL_DIR) $(MODEL_DIR) $(DATATYPES_DIR) $(SOLVERS_DIR)

.SUFFIXES: .o .f90 .f

%.o: %.f90
	$(FC) -c $^ -o $@ $(FFLAGS) $(INCLUDES)

%.o: %.f
	$(FC) -c $^ -o $@ $(FFLAGS) $(INCLUDES)

CFLAGS := $(CFLAGS) -DUSE_MUMPS

