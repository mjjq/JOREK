
MODEL = model300

FC     = mpif90

FFLAGS = -r8 -i4 -O2 -xT -align

#FFLAGS = -r8 -i4 -O0 -check bounds -traceback -align -fpe0 -fp-model strict

MYHOME = $(HOME)
MYLHOME= $(HOME)/lib

MPIDIR= /usr/local/mpich-mx-1.1.4-INTEL
IMPI = -I$(MPIDIR)/include
LMPI = -L$(MPIDIR)/lib

JOREK_DIR = $(MYHOME)/codes/svnjorek/trunk

MAIN_MODEL_DIR = $(JOREK_DIR)/models
MODEL_DIR      = $(MAIN_MODEL_DIR)/$(MODEL)
DATATYPES_DIR  = $(JOREK_DIR)/datatypes
MATRIX_DIR     = $(JOREK_DIR)/matrix
ELEMENTS_DIR   = $(JOREK_DIR)/elements
SOLVERS_DIR    = $(JOREK_DIR)/solvers
VACUUM_DIR     = $(JOREK_DIR)/vacuum

LSCOTCHDIR = $(MYLHOME)/scotch_5.0_esmumps/bin
#LIBSCOTCH   = -L$(LSCOTCHDIR) -lesmumps  -lfax -lorder -lscotch -lscotcherr -lsymbol -ldof -lgraph -lcommon -lm
LIBSCOTCH   = -L$(LSCOTCHDIR) -lscotch -lscotcherr #-lesmumps -lcommon  -lfax -lorder -lsymbol -ldof -lgraph -lcommon -lm

LIBMUMPS = $(MYLHOME)/MUMPS_4.8.1/lib/libdmumps.a  $(MYLHOME)/MUMPS_4.8.1/lib/libmumps_common.a # $(MYLHOME)/MUMPS_4.8.1/lib/libcmumps.a  $(MYLHOME)/MUMPS_4.8.1/lib/libsmumps.a
INCMUMPS = $(MYLHOME)/MUMPS_4.8.1/include/
ORDLIB  = $(MYLHOME)/MUMPS_4.8.1/lib/libpord.a $(MYLHOME)/metis-4.0/libmetis.a #$(LIBSCOTCH)

LIBZMUMPS = $(MYLHOME)/MUMPS_4.8.1/lib/libzmumps.a

PPPLIB    = /home/ichapman/lib/ppplib.a

LIBPASTIX = -L$(MYLHOME)/Release1121/install  -lpastix 
LIBFFTW   = $(MYLHOME)/fftw/lib/libfftw3.a
LIBLAPACK = -L/opt/intel/mkl/10.0.011/lib/em64t /opt/intel/mkl/10.0.011/lib/em64t/libmkl_lapack.a  /opt/intel/mkl/10.0.011/lib/em64t/libmkl_sequential.a /opt/intel/mkl/10.0.011/lib/em64t/libmkl_core.a /opt/intel/mkl/10.0.011/lib/em64t/libguide.a
SCALAP    = -L /opt/intel/mkl/10.0.011/lib/em64t/libmkl_scalapack.a /home/ichapman/lib/scalapack-1.8.0/libscalapack.a
BLACS     = -L /opt/intel/mkl/10.0.011/lib/em64t/libmkl_blacs_intelmpi_ilp64.a /usr/local/fusion/64/lib/blacs_MPI-LINUX-0.a /usr/local/fusion/64/lib/blacsF77init_MPI-LINUX-0.a /usr/local/fusion/64/lib/blacsCinit_MPI-LINUX-0.a
LIBSPARSKIT = -L$(MYLHOME)/SPARSKIT2 -lskit

LIBS =  $(LIBFFTW)  $(LIBPASTIX)  $(LIBSCOTCH) $(LIBMUMPS) $(ORDLIB) $(SCALAP) $(BLACS) $(BLACS) $(LIBLAPACK) $(LIBBLAS) $(PPPLIB) 

#$(BLACS)  $(LIBSCOTCH) $(LIBPASTIX)  $(LIBMUMPS) $(ORDLIB) $(SCALAP) $(BLACS) $(BLACS) $(LIBLAPACK) $(LIBBLAS) $(PPPLIB)  $(LIBFFTW) #$(LIBSCOTCH)  $(LIBSPARSKIT) $(LIBFFTW)  $(LIBPASTIX)   $(LIBMUMPS) $(ORDLIB) $(SCALAP) $(BLACS) $(BLACS)  $(LIBLAPACK) $(LIBBLAS)  $(PPPLIB) #-lrt  $(LIBZMUMPS) 

INCLUDES  = -I$(DATATYPES_DIR) -I$(MODEL_DIR) -I$(MATRIX_DIR) -I$(ELEMENTS_DIR) -I$(VACUUM_DIR) -I$(SOLVERS_DIR) -I$(INCMUMPS)  -I.

VPATH = $(MAIN_MODEL_DIR) $(MODEL_DIR) $(DATATYPES_DIR) $(SOLVERS_DIR)

.SUFFIXES: .o .f90 .f 

%.o: %.f90
	$(FC) -c $^ -o $@ $(FFLAGS) $(INCLUDES)

%.o: %.f
	$(FC) -c $^ -o $@ $(FFLAGS) $(INCLUDES)

CFLAGS := $(CFLAGS) -DUSE_MUMPS

