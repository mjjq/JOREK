
MODEL = model199

FC     = mpif90 -f90=ifort

FFLAGS = -r8 -i4 -O2 -xT -align -mcmodel=medium -openmp -cpp -DUSE_R3_INFO_MPI -DUSE_R3_INFO
#FFLAGS_NO_OMP = -r8 -i4 -O2 -xT -align -cpp -DUSE_R3_INFO_MPI -DUSE_R3_INFO
FFLAGS = -r8 -i4 -O0 -check bounds -traceback -align -openmp -cpp -DUSE_R3_INFO_MPI -DUSE_R3_INFO
#FFLAGS_NO_OMP = -r8 -i4 -O0 -check bounds -traceback -align -openmp -cpp -DUSE_R3_INFO_MPI -DUSE_R3_INFO

CC     = mpicc 
CFLAGS = -DUSE_R3_INFO_MPI -DUSE_R3_INFO

# -i4 for openmpi

FFLAGS_NO_OMP = $(FFLAGS)

MYHOME=/data/JOREK

JOREK_DIR = /home/sipp/gipp/GL310811/jorek2/trunk

COMMUNICATION_DIR = $(JOREK_DIR)/communication
DATATYPES_DIR     = $(JOREK_DIR)/datatypes
DIAGNOSTICS_DIR   = $(JOREK_DIR)/diagnostics
ELEMENTS_DIR      = $(JOREK_DIR)/elements
GRIDS_DIR         = $(JOREK_DIR)/grids
MAIN_MODEL_DIR    = $(JOREK_DIR)/models
MODEL_DIR         = $(MAIN_MODEL_DIR)/$(MODEL)
MATRIX_DIR        = $(JOREK_DIR)/matrix
PLOTS_DIR         = $(JOREK_DIR)/plots
REFINEMENT_DIR    = $(JOREK_DIR)/refinement
SOLVERS_DIR       = $(JOREK_DIR)/solvers
TIMING_DIR        = $(JOREK_DIR)/timing
TOOLS_DIR         = $(JOREK_DIR)/tools
VACUUM_DIR        = $(JOREK_DIR)/vacuum

LIBSCOTCH   = -L$(MYHOME)/scotch_5.1/lib -lptscotch -lptscotcherr

LIBMUMPS  = -L$(MYHOME)/MUMPS_4.7.3/lib/ -ldmumps 
LIBZMUMPS = $(MYHOME)/MUMPS_4.7.3/lib/libzmumps.a
INCMUMPS  = $(MYHOME)/MUMPS_4.7.3/include/
ORDLIB    = $(MYHOME)/MUMPS_4.7.3/lib/libpord.a $(MYHOME)/metis-4.0/libmetis.a $(LSCOTCH)

PPPLIB    = $(MYHOME)/lib/ppplib.a

METIS     = $(MYHOME)/metis-4.0/libmetis.a

LIBPASTIX = -L$(MYHOME)/pastix/install/  -lpastix -lpastix_murge 
INCPASTIX = $(MYHOME)/pastix/install/

LIBFFTW   = $(MYHOME)/fftw/lib/libfftw3.a
LIBLAPACK =  -L/opt/intel/mkl/10.0.011//lib/em64t /opt/intel/mkl/10.0.011//lib/em64t/libmkl_lapack.a  /opt/intel/mkl/10.0.011/lib/em64t/libmkl_sequential.a /opt/intel/mkl/10.0.011/lib/em64t/libmkl_core.a /opt/intel/mkl/10.0.011/lib/em64t/libguide.a

SCALAP    = -L$(MYHOME)/scalapack-1.8.0 -lscalapack_mpich2
BLACS     = $(MYHOME)/BLACS/LIB/blacs_mpich2.a $(MYHOME)/BLACS/LIB/blacsF77init_mpich2.a $(MYHOME)/BLACS/LIB/blacsCinit_mpich2.a

#LIBWSMP = -L$(MYHOME)/wsmp/wsmp/wsmp-Linux64/lib/Intel -lpwsmp64-juropa #-ltcmalloc_minimal -lstacktrace -lunwind -L$(MYHOME)/wsmp/tcmalloc
#LIBWSMP = -L$(MYHOME)/wsmp/wsmp/wsmp-Linux64/lib/Intel/mpich2 -lpwsmp64 #-ltcmalloc_minimal -lstacktrace -lunwind -L$(MYHOME)/wsmp/tcmalloc

LIBS = $(LIBFFTW) $(METIS) $(LIBPASTIX) $(LIBSCOTCH) $(LIBWSMP) $(LIBMUMPS) $(ORDLIB) $(SCALAP) $(BLACS) $(BLACS) $(LIBLAPACK) $(LIBBLAS) $(PPPLIB)

INCLUDES  = -I . -I$(COMMUNICATION_DIR) -I$(DATATYPES_DIR) -I$(DIAGNOSTICS_DIR) -I$(ELEMENTS_DIR)  \
  -I$(GRIDS_DIR) -I$(MAIN_MODEL_DIR) -I$(MODEL_DIR) -I$(MATRIX_DIR) -I$(PLOTS_DIR)                 \
  -I$(REFINEMENT_DIR) -I$(SOLVERS_DIR) -I$(TIMING_DIR) -I$(TOOLS_DIR) -I$(VACUUM_DIR)              \
  -I$(INCMUMPS) -I$(INCPASTIX)

VPATH = $(MAIN_MODEL_DIR) $(MODEL_DIR) $(DATATYPES_DIR) $(SOLVERS_DIR)

.SUFFIXES: .o .f90 .f

%.o: %.f90
	$(FC) -c $^ -o $@ $(FFLAGS) $(INCLUDES)

%.o: %.f
	$(FC) -c $^ -o $@ $(FFLAGS) $(INCLUDES)

%.o: %.c
	$(CC) -c $^ -o $@ $(CFLAGS) $(INCLUDES)

CFLAGS := $(CFLAGS) -DUSE_MUMPS

